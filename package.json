{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NEXUS — Scholarship and Career Advisory System (FYP).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:test": "node supabase/tests/schema.test.mjs && node supabase/tests/rls.test.mjs && node supabase/tests/profile.test.mjs && node supabase/tests/findyourpath.test.mjs && node supabase/tests/scholarship.test.mjs && node supabase/tests/career-pathways.test.mjs && node supabase/tests/chat.test.mjs && node supabase/tests/scraper.test.mjs && node supabase/tests/scholarship-discovery.test.mjs",
    "db:test:schema": "node supabase/tests/schema.test.mjs",
    "db:test:rls": "node supabase/tests/rls.test.mjs",
    "db:test:fyp": "node supabase/tests/findyourpath.test.mjs",
    "db:test:scholarship": "node supabase/tests/scholarship.test.mjs",
    "db:test:careers": "node supabase/tests/career-pathways.test.mjs",
    "db:test:chat": "node supabase/tests/chat.test.mjs",
    "check:secrets": "node scripts/check-bundle-secrets.mjs",
    "verify": "npm run lint && npm run test && npm run build && npm run check:secrets && npm run db:test",
    "db:test:scraper": "node supabase/tests/scraper.test.mjs",
    "db:test:discovery": "node supabase/tests/scholarship-discovery.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "gsap": "^3.15.0",
    "motion": "^13.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.11",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.45",
    "prettier": "^3.3.3",
    "supabase": "^2.120.0",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.3",
    "vitest": "^2.1.9"
  }
}
