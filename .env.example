# Browser-safe configuration. Use your own Supabase project.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_APP_NAME=Nexus
VITE_APP_ENV=development

# Server keys belong in Supabase Edge secrets or GitHub Actions secrets.
# Never prefix server keys with VITE_.
